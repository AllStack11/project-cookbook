# LLM Gateway Configuration
# Supported: openrouter
LLM_PROVIDER=openrouter

# OpenRouter API key
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model selection policy (1 main, 1 fallback)
LLM_PRIMARY_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_FALLBACK_MODEL=amazon/nova-micro-v1

# Backward-compatible override:
# first model -> primary, second -> fallback
# LLM_ALLOWED_MODELS=meta-llama/llama-3.1-8b-instruct,amazon/nova-micro-v1

# Hard monthly spend cap in USD for paid model usage
LLM_MAX_MONTHLY_SPEND_USD=10
LLM_MAX_OUTPUT_TOKENS=2200
LLM_PROVIDER_MAX_RETRIES=1
LLM_REQUEST_TIMEOUT_MS=25000

# YouTube Data API v3 (Optional - fallback for transcript extraction)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
# This is used as a fallback when the primary transcript extraction fails
YOUTUBE_API_KEY=your_youtube_api_key_here

# Caching (optional - using in-memory cache by default)
# Uncomment and configure if you want to use Redis in production
# REDIS_URL=redis://localhost:6379

# Vercel KV (recommended for production - alternative to Redis)
# Get these from Vercel dashboard after creating a KV store
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Payment - Stripe (for future Phase 2)
# Uncomment when you implement monetization features
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10

# Ads - Google AdSense
# Get your client ID from: https://adsense.google.com
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Application
NEXT_PUBLIC_APP_URL=https://your-app-url.vercel.app

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Logs are automatically collected by Vercel and available in:
# - Vercel Dashboard → Your Project → Logs
# - Real-time streaming and searchable JSON logs
# - No external service needed for basic logging
#
# For advanced features (log drains, long-term storage):
# - Go to Vercel Dashboard → Settings → Log Drains
# - Add integrations like Better Stack, Datadog, etc.

# Log Level (optional - defaults based on NODE_ENV)
# - DEBUG: Show all logs (verbose, for debugging)
# - INFO: Show info, warn, error, perf, cost tracking (recommended for production)
# - WARN: Show only warnings and errors (very quiet)
# - ERROR: Show only errors
#
# Default if not set:
# - Development: DEBUG (all logs)
# - Production: INFO (includes cost tracking, excludes verbose debug logs)
#
# LOG_LEVEL=INFO
